# Frontend (safe to expose - these are the public Supabase values)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Public Web Push key (generate with: node scripts/generate-vapid.mjs)
VITE_VAPID_PUBLIC_KEY=

# Server-side secrets: set these in Supabase -> Edge Functions -> Secrets, NEVER in this file
#   LOVABLE_API_KEY   (chat + vision)
#   GEMINI_API_KEY    (OPTIONAL fallback for embeddings; search now works with LOVABLE_API_KEY alone)
#   WORKER_SECRET     (authenticates cron calls; also signs notification Done/Snooze links)
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT   (Web Push; see scripts/generate-vapid.mjs)

# --- Server-side secrets (set with `supabase secrets set`, NOT in this file or the browser) ---
# TELEGRAM_BOT_TOKEN=          # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=     # random string; must match the one passed to scripts/telegram-setup.sh

# --- Optional: ready-made iPhone shortcuts (publish them from the Shortcuts app, copy the iCloud links) ---
# VITE_IOS_SHORTCUT_TELL_URL=https://www.icloud.com/shortcuts/...
# VITE_IOS_SHORTCUT_SCREENSHOT_URL=https://www.icloud.com/shortcuts/...
# VITE_IOS_SHORTCUT_SAVE_URL=https://www.icloud.com/shortcuts/...

# --- Email capture (see README, "Email") ---
# INBOUND_EMAIL_DOMAIN=in.yourdomain.com   # the domain your inbound provider receives mail for
# EMAIL_WEBHOOK_SECRET=                    # random string; used as the password in the provider's webhook URL
# --- Optional outbound email (reminder/brief fallback) ---
# RESEND_API_KEY=
# EMAIL_FROM="V <v@myvinx.tech>"
